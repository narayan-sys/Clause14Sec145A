# Security and caching headers.
# Deliberately conservative: nothing here can stop the page rendering.
# If you want the strict Content-Security-Policy back, it is in the README
# of the previous version — but test it on the live URL before relying on it.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/guide.pdf
  Cache-Control: public, max-age=86400
